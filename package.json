{
  "name": "awaydesk",
  "version": "0.1.0",
  "description": "Drive the Claude Code sessions on your own Mac from private Slack channels. Powered by Claude.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duqaXxX/awaydesk.git"
  },
  "type": "module",
  "bin": {
    "awaydesk": "dist/main.js"
  },
  "files": [
    "dist",
    "slack-app-manifest.json",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "golden": "node test/support/write-golden.ts",
    "test": "node --test --test-timeout=300000 \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@slack/bolt": "5.1.0",
    "@slack/web-api": "8.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
